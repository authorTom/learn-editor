# Copy this file to `.env` (which is gitignored) and adjust as needed.
# Compose automatically reads a sibling `.env` at `docker compose` time.

# Host port to expose the app on (the container always listens on 8080).
PORT=8080

# Which published image tag to run. `latest` tracks the newest build;
# pin to a version/sha (e.g. sha-abc1234) for reproducible deploys.
IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# Accounts and sync
# ---------------------------------------------------------------------------

# `on`  — multi-user: sign-in required, courses sync to the server.
# `off` — the original behaviour: a plain static host with no accounts, every
#         course living only in the browser that made it, nothing uploaded.
QUOIN_AUTH=on

# How long a sign-in lasts before it has to be repeated.
QUOIN_SESSION_TTL_DAYS=30

# Fix the first-run setup token rather than having one generated and printed to
# the container log. Only has any effect while there are no accounts yet.
# QUOIN_SETUP_TOKEN=

# ---------------------------------------------------------------------------
# Behind a reverse proxy
# ---------------------------------------------------------------------------

# Turn both of these on when a TLS-terminating proxy (Caddy, nginx, Traefik)
# sits in front, and only then.
#
# QUOIN_TRUST_PROXY makes the login rate limiter read X-Forwarded-For. With no
# proxy actually setting that header, any client could forge its own address
# and get a fresh allowance of guesses — which is why it is off by default.
#
# QUOIN_SECURE_COOKIES marks the session cookie Secure. Correct over https and
# fatal without it: browsers never send a Secure cookie over plain http, so
# turning this on for an http:// deployment means nobody can stay signed in.
QUOIN_TRUST_PROXY=off
QUOIN_SECURE_COOKIES=off

# debug | info | warn | error | silent
QUOIN_LOG_LEVEL=info

# Largest single request the API will accept, in megabytes. Courses carry
# embedded media, so this is generous by necessity.
# QUOIN_MAX_BODY_MB=32
